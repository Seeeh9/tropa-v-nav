// Акт 2. Мёртвая деревня и болота. HP — для одного игрока.
// Анчутки по документу ещё и меняются местами каждый ход — это чисто зрительное, не сделано.
[
    (
        // Кровопийца: лечится на половину нанесённого урона
        id: "upyr", hp: (45, 45), flags: ["lifesteal"],
        moves: [
            (id: "bloodsuck", intent: Attack, targeted: true, effects: [Damage(N(10), Target)]),
            (id: "lunge", intent: Attack, targeted: true, effects: [Damage(N(13), Target)]),
        ],
        pattern: [0, 1, 0],
    ),
    (
        // Тянет на дно: герой теряет 1 энергию в следующем ходу
        id: "drowned_maiden", hp: (35, 35),
        moves: [
            (id: "drag_under", intent: Debuff, targeted: true, effects: [Damage(N(5), Target), Hook("drag_under")]),
            (id: "cold_hands", intent: Attack, targeted: true, effects: [Damage(N(11), Target)]),
        ],
        pattern: [0, 1, 1],
    ),
    (
        // Плач: всем героям Надлом; прячется за другими врагами
        id: "igosha", hp: (20, 20), flags: ["hiding"],
        moves: [
            (id: "wail", intent: Debuff, effects: [Apply(Vulnerable, N(1), AllFoes)]),
            (id: "nip", intent: Attack, targeted: true, effects: [Damage(N(6), Target)]),
        ],
        pattern: [0, 1, 1],
    ),
    (
        id: "anchutka", hp: (12, 12),
        moves: [
            (id: "pinch", intent: Attack, targeted: true, effects: [Damage(N(4), Target)]), (id: "snatch", intent: Debuff, targeted: true, effects: [Hook("anchutka_snatch")]),
        ],
        pattern: [0, 1, 0],
    ),
    (
        // через 2 хода взрывается: 12 урона всем
        id: "swamp_light", hp: (15, 15),
        moves: [
            (id: "flicker", intent: Unknown, effects: []),
            (id: "burst", intent: AttackAll, effects: [Damage(N(12), AllFoes), LoseHp(N(99), Me)]),
        ],
        pattern: [0, 0, 1],
    ),
    (
        id: "tinyak", hp: (40, 40),
        moves: [
            (id: "silt", intent: Debuff, targeted: true, effects: [AddCard(card: "mire", pile: Discard, to: Target, count: 2)]),
            (id: "mud_fist", intent: Attack, targeted: true, effects: [Damage(N(12), Target)]),
        ],
        pattern: [0, 1, 1],
    ),
    (
        // пьёт силу: забирает у героя 1 Силу себе
        id: "yrka", hp: (38, 38),
        moves: [
            (id: "drink_strength", intent: Debuff, targeted: true, effects: [Apply(Strength, N(-1), Target), Apply(Strength, N(1), Me)]),
            (id: "claw", intent: Attack, targeted: true, effects: [Damage(N(11), Target)]),
        ],
        pattern: [0, 1, 1],
    ),

    // ---- элиты ----
    (
        // поднимает павших врагов с 50% HP раз в 3 хода
        id: "vurdalak_elder", hp: (160, 160),
        moves: [
            (id: "raise_dead", intent: Summon, effects: [Hook("raise_dead")]),
            (id: "rend", intent: Attack, targeted: true, effects: [Damage(N(16), Target), AddCard(card: "corpse_poison", pile: Discard, to: Target)]),
            (id: "drain_all", intent: AttackAll, effects: [Damage(N(8), AllFoes), Heal(N(8), Me)]),
        ],
        pattern: [1, 2, 0],
    ),
    (
        // «Полдень» 3→0: удар 30 по всем. Оглушённая, она пропускает ход, и удар не случается
        id: "poludnitsa", hp: (140, 140),
        moves: [
            (id: "sickle", intent: Attack, targeted: true, effects: [Damage(N(14), Target), AddCard(card: "burn", pile: Discard, to: Target)]),
            (id: "noon", intent: AttackAll, effects: [Damage(N(30), AllFoes)]),
        ],
        pattern: [0, 0, 0, 1],
    ),
    (
        // раздаёт «Лихорадку»: проклятие, переходящее к соседнему герою каждый ход
        id: "tryasovitsa", hp: (150, 150),
        moves: [
            (id: "fever", intent: Debuff, targeted: true, effects: [AddCard(card: "fever", pile: Draw, to: Target)]),
            (id: "shaking_grip", intent: Attack, targeted: true, effects: [Damage(N(15), Target)]),
            (id: "chill", intent: Attack, targeted: true, effects: [Hits(N(6), 3, Target)]),
        ],
        pattern: [0, 1, 2],
    ),

    // ---- босс ----
    (
        // затягивает героев в трясину: они не ходят, пока союзник не сыграет на них карту;
        // иначе в конце хода трясина берёт 8 HP и отпускает. Берёт двоих, но не всю партию;
        // одиночку вытащить некому — он теряет ход и 8 HP
        id: "bolotnik", hp: (380, 380),
        moves: [
            (id: "quagmire", intent: Special, effects: [Hook("mire_grab")]),
            (id: "pull_down", intent: Attack, targeted: true, effects: [Damage(N(20), Target)]),
            (id: "mud_wave", intent: AttackAll, effects: [Damage(N(12), AllFoes)]),
            (id: "sink", intent: Defend, effects: [Block(N(25), Me), Heal(N(10), Me)]),
        ],
        opening: [0],
        pattern: [1, 2, 0, 1, 3, 2],
    ),
]
