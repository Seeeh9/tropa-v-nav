// Акт 3. Навь. HP — для одного игрока.
[
    (
        // половина урона проходит сквозь щит
        id: "nav_soul", hp: (50, 50), flags: ["piercing"],
        moves: [
            (id: "pass_through", intent: Attack, targeted: true, effects: [Damage(N(12), Target)]),
            (id: "moan", intent: Debuff, effects: [Apply(Weak, N(1), AllFoes)]),
        ],
        pattern: [0, 0, 1],
    ),
    (
        // встаёт один раз с 50% HP (по документу — если не добита «Огнём»; огня как вида урона ещё нет)
        id: "kostomakha", hp: (55, 55), flags: ["rises"],
        moves: [
            (id: "bone_blow", intent: Attack, targeted: true, effects: [Damage(N(13), Target)]),
            (id: "rattle", intent: Defend, effects: [Block(N(12), Me)]),
        ],
        pattern: [0, 0, 1],
    ),
    (
        // «Очарование»: следующая атака героя бьёт союзника (в одиночку — пропадает)
        id: "mavka", hp: (45, 45),
        moves: [
            (id: "charm", intent: Special, targeted: true, effects: [Hook("charm")]),
            (id: "embrace", intent: Attack, targeted: true, effects: [Damage(N(12), Target)]),
        ],
        pattern: [0, 1, 1],
    ),
    (
        // щит 15 каждый второй ход; Пробой 16
        id: "koschei_guard", hp: (70, 70),
        moves: [
            (id: "pierce", intent: Attack, targeted: true, effects: [Damage(N(16), Target)]),
            (id: "shield_up", intent: Defend, effects: [Block(N(15), Me)]),
        ],
        pattern: [1, 0],
    ),
    (
        // медленный: тяжёлый удар 24 раз в 2 хода
        id: "volot", hp: (90, 90),
        moves: [
            (id: "wind_up", intent: Unknown, effects: []),
            (id: "heavy_blow", intent: Attack, targeted: true, effects: [Damage(N(24), Target)]),
        ],
        pattern: [0, 1],
    ),
    (
        // усиливает других врагов, пока жива
        id: "weeper", hp: (30, 30),
        moves: [
            (id: "lament", intent: Buff, effects: [Apply(Strength, N(2), OtherFriends)]),
            (id: "keen", intent: Attack, targeted: true, effects: [Damage(N(6), Target)]),
        ],
        pattern: [0, 1, 1],
    ),
    (
        // летает: первый удар по нему за ход проходит мимо
        id: "raven_upyr", hp: (20, 20), flags: ["dodge"],
        moves: [
            (id: "swoop", intent: Attack, targeted: true, effects: [Damage(N(8), Target)]),
        ],
        pattern: [0],
    ),

    // ---- элиты ----
    (
        // Песня: герои ход не видят намерений; Сон: герой пропускает ход
        id: "sirin", hp: (180, 180),
        moves: [
            (id: "song", intent: Special, effects: [Hook("sirin_song"), Apply(Weak, N(1), AllFoes)]),
            (id: "talons", intent: Attack, targeted: true, effects: [Hits(N(9), 2, Target)]),
            (id: "lullaby", intent: Special, targeted: true, effects: [Hook("sleep")]),
            (id: "dive", intent: Attack, targeted: true, effects: [Damage(N(22), Target)]),
        ],
        pattern: [0, 1, 2, 3],
    ),
    (
        // бьёт двумя атаками по разным героям (в одиночку — обе в одного)
        id: "black_rider", hp: (200, 200),
        moves: [
            (id: "two_strikes", intent: AttackAll, effects: [Damage(N(13), RandomFoe), Damage(N(13), RandomFoe)]),
            (id: "charge", intent: Attack, targeted: true, effects: [Damage(N(24), Target)]),
            (id: "banner", intent: Buff, effects: [Apply(Strength, N(2), Me), Block(N(14), Me)]),
        ],
        pattern: [0, 1, 2, 0],
    ),
    (
        // Землетрясение: герои в руки возьмут на 2 карты меньше (в документе — сбрасывают 2;
        // во время хода врагов рука пуста, поэтому потеря приходится на следующий добор)
        id: "volot_giant", hp: (220, 220),
        moves: [
            (id: "earthquake", intent: AttackAll, effects: [Damage(N(12), AllFoes), Hook("quake")]),
            (id: "stomp", intent: Attack, targeted: true, effects: [Damage(N(28), Target)]),
            (id: "boulder", intent: Defend, effects: [Block(N(18), Me)]),
        ],
        pattern: [0, 2, 1],
    ),

    // ---- босс ----
    (
        // ледяной венец — отдельная цель: пока он цел, зима отнимает у героев по карте добора
        id: "ice_crown", hp: (70, 70), start_block: 10,
        moves: [(id: "glitter", intent: Defend, effects: [Block(N(10), Me)])],
        pattern: [0],
        on_death: [Hook("thaw")],
    ),
    (
        // замораживает карты в руках; пока цел венец, каждый её ход добор героев меньше на 1 (до 3)
        id: "mara", hp: (480, 480),
        moves: [
            (id: "winter_comes", intent: Special, effects: [Hook("winter"), Hook("freeze")]),
            (id: "ice_scythe", intent: Attack, targeted: true, effects: [Damage(N(26), Target), Hook("winter")]),
            (id: "blizzard", intent: AttackAll, effects: [Damage(N(14), AllFoes), Hook("winter")]),
            (id: "frost_breath", intent: Special, effects: [Hook("freeze"), Block(N(20), Me), Hook("winter")]),
        ],
        opening: [0],
        pattern: [1, 2, 3, 1, 2, 0],
    ),
]
